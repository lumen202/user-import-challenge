{
    "name": "lumen202/user-import",
    "description": "CSV to PostgreSQL user import - CLI and web UI over a shared PHP core",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "UserImport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UserImport\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/index.php",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit",
        "check": [
            "@lint",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
